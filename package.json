{
  "name": "bioalign-pro",
  "version": "1.0.0",
  "description": "BioAlign-Pro — Research-Grade Pairwise DNA & Protein Sequence Alignment",
  "main": "js/main.js",
  "scripts": {
    "build:css": "npx tailwindcss -i ./css/tailwind.input.css -o ./css/tailwind.output.css --minify",
    "build:js": "npx esbuild js/main.js --bundle --minify --outdir=dist --splitting --format=esm --chunk-names=chunks/[name]-[hash] --target=es2020",
    "build": "npm run build:css && npm run build:js",
    "dev": "npx serve . -p 8080",
    "test": "npm run test:dp && npm run test:score && npm run test:standards",
    "test:dp": "node test_dp.mjs",
    "test:score": "node test_score.mjs",
    "test:standards": "node test_research_standards.mjs",
    "lint": "npx eslint ."
  },
  "keywords": [
    "bioinformatics",
    "sequence-alignment",
    "needleman-wunsch",
    "smith-waterman",
    "BLAST"
  ],
  "author": "Siddharth Tripathi",
  "license": "ISC",
  "type": "module",
  "devDependencies": {
    "@tailwindcss/aspect-ratio": "^0.4.2",
    "@tailwindcss/forms": "^0.5.7",
    "@tailwindcss/typography": "^0.5.10",
    "autoprefixer": "^10.4.27",
    "esbuild": "^0.20.2",
    "postcss": "^8.5.8",
    "tailwindcss": "^3.4.1"
  },
  "dependencies": {
    "cors": "^2.8.5",
    "express": "^4.21.2"
  }
}